{
  "version": "1.0",
  "brand": "巧荷",
  "description": "巧荷品牌小红书标题公式库。所有公式遵循'东方高级、当代克制、女性主体性'调性。",
  "tone_constraints": {
    "max_chars": 30,
    "exclamation_limit": 1,
    "forbidden_words": ["汉服", "古风", "国风", "仙气", "飘逸", "小仙女", "性价比", "便宜", "打折", "快消", "网红同款", "震惊", "绝绝子", "yyds"],
    "preferred_words": ["云", "丝", "锦", "气韵", "留白", "克制", "风骨", "从容", "温润", "质感", "当代", "东方"]
  },
  "formulas": [
    {
      "id": "F1",
      "name": "主体性表达",
      "template": "我{动词}_{物件}，终于{结果描述}",
      "examples": ["我有我的东方骨", "我的衣橱里，没有不合身的衣服", "我的云，从不跟随别人的天"],
      "applicable_pipelines": ["A1", "A2", "A3"],
      "voice": "first_person_subjective"
    },
    {
      "id": "F2",
      "name": "年龄×物件×哲思",
      "template": "{年龄/时间}_{物件}_{哲思短句}",
      "examples": ["三十岁后，我穿衣服只看这一件事", "四十岁才懂：好衣服是会跟着你长大的", "二十多岁买衣服，三十多岁选气质"],
      "applicable_pipelines": ["A1", "A2"],
      "voice": "reflective"
    },
    {
      "id": "F3",
      "name": "反常识破除",
      "template": "{物件}不{流行词}，却{反差表达}",
      "examples": ["这件衣服不网红，却让我被问爆链接", "东方美学不复古，却让我从不在人群里被忽略", "她穿得素，却比所有人都有记忆点"],
      "applicable_pipelines": ["A1", "A2", "A3"],
      "voice": "counter_intuitive"
    },
    {
      "id": "F4",
      "name": "场景代入",
      "template": "{具体场景}_{穿着选择}_{感受}",
      "examples": ["茶会那天，我穿了件不像'礼服'的礼服", "出差轻装时，这件云锦成了我的定海神针", "朋友聚会前，我没再翻那件黑色小礼服"],
      "applicable_pipelines": ["A2", "A3"],
      "voice": "scene_anchored"
    },
    {
      "id": "F5",
      "name": "短句平行",
      "template": "{短句A} | {短句B}",
      "examples": ["云无形，自有气度", "衣如人，慢慢来", "贵一点，穿久一点"],
      "applicable_pipelines": ["A3", "B"],
      "voice": "concise_parallel"
    },
    {
      "id": "F6",
      "name": "穿衣哲学",
      "template": "{洞察/反问}_{哲思化穿搭建议}",
      "examples": ["穿衣难的不是赶时髦，而是找到自己的气韵", "为什么你的衣服总像借来的？", "为什么你穿香云纱总像在演古装？"],
      "applicable_pipelines": ["A1", "A2"],
      "voice": "philosophical"
    }
  ]
}
