# .env.example — 全量 env 键说明。拷成 .env 填真值(.env 不入库,泄漏即轮换)。
# 飞书 Bitable base token。默认填测试 Base(ZhzJbfkOsafwevsWkW8cfoILnfb)——一切写操作只进测试 Base;生产切换见 docs/PLAN.md P7
LARK_APP_TOKEN=ZhzJbfkOsafwevsWkW8cfoILnfb
# 火山方舟(豆包/Seedance)API key,video-previz 生成 AI 参考片用
ARK_API_KEY=
# TikHub API key,xhs-extract-master 等技能的渐进增强取数用
TIKHUB_API_KEY=
# Apify 平台 token(零封号取数,apify_xhs.py)
APIFY_TOKEN=
# Apify 上跑哪个小红书 Actor(换源只改这行;格式 username~actorname)
APIFY_XHS_ACTOR=socialdatax~socialdatax-xhs-data-api
# 红狐(redfox.hk)XHS 账号画像 API key(零封号补数)
REDFOX_API_KEY=
# 取数链:逗号分隔的 adapter 顺序,逐字段合并(apify/redfox=零封号 / browser=小号兜底 / mock=离线)
XHS_FETCH_CHAIN=apify,redfox,browser
# Seedance 视频生成模型 ID(video-previz 用,复用 ARK key)
SEEDANCE_MODEL=doubao-seedance-2-0-mini-260615
# 测试模式硬开关:1=写入前校验目标必须是测试 Base,非测试 token 拒绝写入(P4a 焊入代码)
TEST_MODE=1
